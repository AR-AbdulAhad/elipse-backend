# ── Server Config ──
PORT=3000

# ── Database Config (Prisma & MySQL) ──
DATABASE_URL=mysql://user:password@localhost:3306/dbname
DB_HOST=localhost
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname
DB_PORT=3306

# ── Authentication ──
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=info@elipsestudio.com
ADMIN_PASSWORD=admin123

# ── SMTP Email Config ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@elipsestudio.com
SMTP_PASS=password
FROM_EMAIL=noreply@elipsestudio.com
RECIPIENT_EMAIL=info@elipsestudio.com

# ── App & Frontend URLs ──
BACKEND_URL=https://mediumseagreen-crocodile-699024.hostingersite.com
VITE_BACKEND_URL=https://mediumseagreen-crocodile-699024.hostingersite.com
FRONTEND_URL=https://elipsestudio.com
SITE_URL=https://elipsestudio.com

# ── Uploads Path (Optional override) ──
# UPLOADS_PATH=

# ── Prerender Server Config (Puppeteer SPA SEO) ──
SPA_URL=https://elipsestudio.com
NAV_TIMEOUT=30000
EXTRA_WAIT_MS=2000

# ── Prerender Cache Config ──
# Redis (Optional — defaults to In-Memory cache if REDIS_URL is blank)
REDIS_URL=
REDIS_PASSWORD=

CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEMS=500

# Path to custom Chromium executable (optional, leave empty for Puppeteer bundled Chrome)
CHROME_EXECUTABLE_PATH=
