// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id           Int      @id @default(autoincrement())
  interest     String
  user_name    String
  user_company String?
  user_email   String
  user_phone   String?
  user_source  String?
  message      String   @db.Text
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Meeting {
  id          Int      @id @default(autoincrement())
  email       String
  title       String   @default("New Meeting Request")
  date        String
  time        String
  description String   @default("A user has requested to join from the email section.") @db.Text
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
